#!/bin/bash
# Environment variables for local development
# Copy this file to local_env.sh and update with your settings

# Google Cloud settings
export PROJECT="your-google-cloud-project-id"
export REGION="us-central1"
export MODEL_NAME="gemini-2.0-flash-lite"  # Or your preferred model

# Looker SDK settings
export LOOKERSDK_BASE_URL="https://your-looker-instance.cloud.looker.com"
export LOOKERSDK_CLIENT_ID="your-client-id"
export LOOKERSDK_CLIENT_SECRET="your-client-secret"
export LOOKERSDK_VERIFY_SSL="false"  # Set to "true" in production

# Flask settings
export PORT=8000

# Set logging to DEBUG for local development
export LOG_LEVEL="DEBUG"

# IMPORTANT: Make sure the Flask app runs in local mode
# This is critical for local development
export FLASK_ENV=development
export FLASK_DEBUG=1

# NOTE: Do NOT set FUNCTIONS_FRAMEWORK=1 for local development
# It would cause the Flask server to terminate immediately
