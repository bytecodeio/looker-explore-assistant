  "test_cases": [
    {
      "test_id": "product_sku_validation",
      "name": "Product SKU Filter Validation",
      "description": "Verify that product SKU queries generate proper filters",
      "priority": "critical",
      "tags": ["product_sku", "vector_search"],
      
      "request": {
        "endpoint": "/api/v1/query",
        "method": "POST",
        "data": {
          "query": "tell me about sales 0006AABE0BA47A35C0B0BF6596F85159",
          "restricted_explore_keys": ["sales_demo_the_look:order_items"],
          "debug": true
        },
        "timeout": 30.0
      },
      
      "validations": [
        {
          "field_path": "success",
          "operator": "equals",
          "expected_value": true,
          "description": "Response should be successful"
        },
        {
          "field_path": "data.explore_key",
          "operator": "equals", 
          "expected_value": "sales_demo_the_look:order_items",
          "description": "Should select correct explore"
        },
        {
          "field_path": "data.parameters.filters.products.sku",
          "operator": "equals",
          "expected_value": "0006AABE0BA47A35C0B0BF6596F85159", 
          "description": "Should filter by the specific product SKU"
        },
        {
          "field_path": "debug_info",
          "operator": "has_key",
          "description": "Should include debug information"
        },
        {
          "field_path": "data.generation_metadata.vector_search_used",
          "operator": "length_greater_than",
          "expected_value": 0,
          "description": "Should have used vector search"
        }
      ]
    }
  ],
  
  "reporting": {
    "save_debug_logs": true,
    "include_response_data": true,
    "verbose_validation_output": true
  }
}